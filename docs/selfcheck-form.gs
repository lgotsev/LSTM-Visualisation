/**
 * Създава Google Form „LSTM — самопроверка“ като тест (quiz) с автоматична проверка.
 * 10 въпроса по четирите секции на LSTM визуализацията, по 1 точка.
 *
 * Как се пуска:
 * 1. Отворете https://script.google.com → „Нов проект“.
 * 2. Изтрийте примерния код и поставете целия този файл.
 * 3. Изберете функцията createLstmQuiz и натиснете „Изпълни“ (Run).
 *    При първо пускане Google ще поиска разрешение за Google Forms — потвърдете.
 * 4. Отворете „Журнал за изпълнение“ (Execution log): там са линкът за студентите
 *    (за приложението) и линкът за редактиране (за вас).
 */
function createLstmQuiz() {
  const form = FormApp.create('LSTM — самопроверка');
  form
    .setDescription(
      'Самопроверка след лекцията и упражнението по рекурентни мрежи и LSTM. ' +
      '10 въпроса, по един верен отговор. Резултатът се показва веднага след изпращане.'
    )
    .setIsQuiz(true)
    .setShuffleQuestions(false)
    .setProgressBar(true)
    .setConfirmationMessage('Благодаря! Вижте резултата си и обясненията към всеки въпрос.');
  // Отговорите на другите студенти не се показват.
  form.setPublishingSummary(false);

  form.addTextItem().setTitle('Име и факултетен номер').setRequired(true);

  const QUESTIONS = [
    {
      q: 'Защо многослойният перцептрон не е удобен за текст?',
      a: ['Търси вход с фиксиран размер и не вижда реда на думите', 'Не може да се обучава с градиент', 'Работи само с числа между 0 и 1'],
      correct: 0,
      why: 'MLP очаква вектор с фиксирана дължина и обработва всичко наведнъж; редът на думите не е част от изчислението.',
    },
    {
      q: 'Какво е скритото състояние hₜ в RNN?',
      a: ['Последната прочетена дума', 'Вектор, който обобщава прочетеното до момента', 'Теглата на мрежата'],
      correct: 1,
      why: 'hₜ се обновява от новата дума и от hₜ₋₁ — това е паметта на мрежата.',
    },
    {
      q: 'Какво е embedding?',
      a: ['Номерът на думата в речника', 'Вектор от числа за всяка дума, научен при обучението', 'Преводът на думата на друг език'],
      correct: 1,
      why: 'Номерът сам не носи смисъл; затова всяка дума получава вектор (при нас 8 числа), който мрежата настройва.',
    },
    {
      q: 'Какво означава, че RNN използва „поделени тегла“?',
      a: ['Едни и същи тегла се прилагат на всяка стъпка', 'Теглата се делят поравно между думите', 'Няколко мрежи ползват едни тегла'],
      correct: 0,
      why: 'Разгъната във времето, RNN е дълбока мрежа, в която всеки „слой“ има едни и същи Wₓ, Wₕ и b.',
    },
    {
      q: 'Ако на всяка стъпка назад градиентът се умножава по 0.9, какво става след 50 стъпки?',
      a: ['Остава почти същия', 'Става практически нула (около 0.005)', 'Става много голям'],
      correct: 1,
      why: '0.9⁵⁰ ≈ 0.005 — градиентът затихва.',
    },
    {
      q: 'Какъв е основният проблем на обикновената RNN?',
      a: ['Трудно се научава да свързва далечни думи, защото градиентът затихва', 'Не може да чете текст, по-дълъг от 10 думи', 'Има твърде много параметри'],
      correct: 0,
      why: 'Проблемът е в обучението: сигналът от далечните стъпки не стига до теглата.',
    },
    {
      q: 'Какво прави forget gate в LSTM?',
      a: ['Решава колко от новата дума да влезе', 'Решава колко от старата памет cₜ₋₁ да остане', 'Решава колко от паметта да се покаже навън'],
      correct: 1,
      why: 'cₜ = fₜ·cₜ₋₁ + iₜ·gₜ — fₜ умножава старата памет.',
    },
    {
      q: 'Ако forget gate е заключен на 0, какво помни клетката?',
      a: ['Всички думи досега', 'Само първата дума', 'Само текущата дума'],
      correct: 2,
      why: 'При f = 0 остава cₜ = iₜ·gₜ: паметта се нулира на всяка стъпка.',
    },
    {
      q: 'Защо LSTM помни по-далеч от RNN?',
      a: ['Защото има повече параметри', 'Защото паметта cₜ се променя само с умножение по f и събиране, и градиентът не затихва бързо', 'Защото чете текста отзад напред'],
      correct: 1,
      why: 'По „конвейерната лента“ градиентът се умножава по f ≈ 0.9, а не по пълна матрица и tanh′.',
    },
    {
      q: 'Колко пъти повече параметри има LSTM от RNN със същите размери?',
      a: ['2 пъти', '4 пъти', '8 пъти'],
      correct: 1,
      why: 'LSTM има четири блока (f, i, g, o) с размерите на една RNN: 4 · [h(h + x) + h].',
    },
  ];

  QUESTIONS.forEach((item, n) => {
    const mc = form.addMultipleChoiceItem();
    mc.setTitle(`${n + 1}. ${item.q}`)
      .setChoices(item.a.map((text, k) => mc.createChoice(text, k === item.correct)))
      .setRequired(true)
      .setPoints(1)
      .setFeedbackForCorrect(FormApp.createFeedback().setText('Вярно. ' + item.why).build())
      .setFeedbackForIncorrect(FormApp.createFeedback().setText(item.why).build());
  });

  Logger.log('Линк за студентите (за приложението): ' + form.shortenFormUrl(form.getPublishedUrl()));
  Logger.log('Пълен линк за студентите: ' + form.getPublishedUrl());
  Logger.log('Линк за редактиране (само за вас): ' + form.getEditUrl());
}
